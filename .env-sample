# EZ Tasker environment sample
# Copy to .env and replace placeholder values before running in production.

# Required: app secret (must be non-empty and not "change-me")
SECRET_KEY=replace-with-strong-random-secret

# Required: shared HMAC secret used to verify the user_sig auth cookie
SECURE_AUTH_SECRET=replace-with-shared-auth-signing-secret

# Optional during SECURE_AUTH_SECRET rotation:
# comma-separated previous signing secret(s) accepted for verify fallback.
# SECURE_AUTH_PREVIOUS_SECRETS=old-shared-secret-1,old-shared-secret-2

# Required: secret used to derive stable per-user storage IDs
USER_ID_SECRET=replace-with-strong-random-secret

# Optional during USER_ID_SECRET rotation:
# keep previous secret(s) comma-separated until all users have logged in at least once.
# USER_ID_PREVIOUS_SECRETS=old-secret-1,old-secret-2

# Required: URL-safe base64 key that decodes to exactly 32 bytes
# Example generator:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
DATA_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key

# Optional during DATA_ENCRYPTION_KEY rotation:
# previous key(s) used only for decrypt fallback, comma-separated.
# DATA_ENCRYPTION_PREVIOUS_KEYS=old-key-1,old-key-2

# Required: expected audience claim in auth bootstrap cookie
BOOTSTRAP_COOKIE_AUDIENCE=tasks.blahpunk.com

# Optional: application environment (production|development|local|dev)
# APP_ENV=production

# Optional: auth mode (oauth|dev). Keep oauth in production.
# AUTH_MODE=oauth

# Optional: dev-mode login identity used by /dev-login
# DEV_USER_EMAIL=dev@localhost.test

# Optional: max bootstrap token age in seconds (default: 300)
BOOTSTRAP_COOKIE_MAX_AGE_SECONDS=300

# Optional: allowed clock skew in seconds (default: 60)
BOOTSTRAP_COOKIE_CLOCK_SKEW_SECONDS=60

# Optional: data directory (default: /var/lib/ez_tasker)
# DATA_DIR=/var/lib/ez_tasker

# Optional: sqlite DB path (default: ${DATA_DIR}/tasks.db)
# DB_PATH=/var/lib/ez_tasker/tasks.db

# Optional: static cache-busting version string
# STATIC_ASSET_VERSION=20260308
